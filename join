<script>
(function(){
  // FAQ toggle
  document.querySelectorAll('.faq-item button').forEach(function(b){
    b.addEventListener('click',function(){
      var open=b.getAttribute('aria-expanded')==='true';
      b.setAttribute('aria-expanded',String(!open));
      document.getElementById(b.getAttribute('aria-controls')).hidden=open;
    });
  });
  // reveal on scroll
  var els=document.querySelectorAll('.reveal');
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce||!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('in');});}
  else{var io=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});},{threshold:.12});
    els.forEach(function(e){io.observe(e);});}
  // demo form: no sending, no storing
  var f=document.getElementById('applyForm'),done=document.getElementById('done');
  f.addEventListener('submit',function(ev){
    ev.preventDefault();
    if(!f.checkValidity()){f.reportValidity();return;}
    done.textContent='신청이 접수되었습니다(데모)';
    done.hidden=false;
    f.reset();
  });
})();
</script>
