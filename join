.pm{position:absolute;right:22px;top:50%;width:24px;height:24px;margin-top:-12px;border-radius:50%;background:var(--acc)}
.pm::before,.pm::after{content:"";position:absolute;left:6px;right:6px;top:11px;height:2px;background:#fff;transition:transform .25s}
.pm::after{transform:rotate(90deg)}
button[aria-expanded="true"] .pm::after{transform:rotate(0)}
.faq-a{padding:0 24px 20px}.faq-a p{color:var(--muted);font-weight:500}
