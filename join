@media print{*{-webkit-print-color-adjust:exact;print-color-adjust:exact}.glass{-webkit-backdrop-filter:none;backdrop-filter:none;background:#fff;box-shadow:none;border:1px solid #eee}.reveal{opacity:1;translate:none}.nav{position:static}}
</style>
